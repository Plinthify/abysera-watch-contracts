{
  "name": "@abysera/watch-contracts",
  "version": "0.1.3",
  "description": "Shared watch and wake payload schemas for Abysera services and MCP servers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs && node scripts/validate-normalized-time-schedules.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
